{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://icon-shoppers.onrender.com/api/:path*"
    },
    {
      "source": "/storage/:path*",
      "destination": "https://icon-shoppers.onrender.com/storage/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ]
}
