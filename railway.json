{
    "services": {
      "backend": {
        "build": {
          "base": "php:8.2",
          "commands": [
            "cd backend",
            "composer install",
            "php artisan migrate --force",
          ]
        },
        "start": "php artisan serve --host=0.0.0.0 --port=$PORT",
        "env": ".env"
      },
      "frontend": {
        "build": {
          "base": "node:18",
          "commands": [
            "cd frontend",
            "npm install",
            "npm run build"
          ]
        },
        "start": "cd frontend && npm start"
      }
    }
  }
  
